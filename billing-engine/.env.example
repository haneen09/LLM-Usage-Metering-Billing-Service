# Database — SQLite by default for local dev. Swap for a Postgres URL later
# if you want, e.g. postgresql://user:pass@localhost:5432/billing
DATABASE_URL=sqlite:///./billing.db

# Stripe test-mode keys — get these from your Stripe dashboard (test mode toggle on)
# NEVER put real/live keys here, and never commit this file with real values filled in
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
